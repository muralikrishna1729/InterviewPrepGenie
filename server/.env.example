DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aiinterviewer
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=
JWT_EXPIRE_DAYS=7
GROQ_API_KEY=
OPENAI_KEY= 
FRONTEND_URL=http://localhost:5173
PORT=5000
ENVIRONMENT=development
# Logging level: DEBUG / INFO / WARNING / ERROR (defaults: DEBUG in dev, INFO in prod)
LOG_LEVEL=
# Set true to echo every SQL query (off by default — SQL logging is noisy)
SQL_DEBUG=false
